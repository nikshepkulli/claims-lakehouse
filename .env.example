# Local development defaults ONLY. Not secrets. Copy to .env: `cp .env.example .env`
COMPOSE_PROJECT_NAME=claims-lakehouse

# MinIO (S3-compatible object store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redpanda (Kafka API) + Console
REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_CONSOLE_PORT=8080

# Spark standalone
SPARK_MASTER_UI_PORT=8081
SPARK_MASTER_PORT=7077
SPARK_WORKER_UI_PORT=8082
SPARK_WORKER_MEMORY=1g
SPARK_WORKER_CORES=2

# Postgres (serving / metadata)
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse-local
POSTGRES_DB=lakehouse
POSTGRES_PORT=5432

# Marquez lineage (compose profile `lineage`)  (5000 clashes with macOS AirPlay)
MARQUEZ_DB_USER=marquez
MARQUEZ_DB_PASSWORD=marquez-local
MARQUEZ_API_PORT=5002
MARQUEZ_ADMIN_PORT=5003
MARQUEZ_WEB_PORT=3002

# Interface for ALL published ports. Default is loopback-only because the stack ships
# default passwords. Set to 0.0.0.0 only on a trusted network (see docs/local-stack.md).
BIND_ADDR=127.0.0.1
