FROM "bad"."staging"."stg_gold__fact_claim" AS c
INNER JOIN "bad"."staging"."stg_gold__dim_member" AS m ON c.member_sk = m.member_sk
INNER JOIN "bad"."staging"."stg_gold__dim_provider" AS p ON c.provider_sk = p.provider_sk
WHERE
    c.service_date < cast(m.valid_from AS date)
    OR (m.valid_to IS NOT NULL AND c.service_date >= cast(m.valid_to AS date))
    OR c.service_date < cast(p.valid_from AS date)
    OR (p.valid_to IS NOT NULL AND c.service_date >= cast(p.valid_to AS date))
  
  
      
    ) dbt_internal_test
