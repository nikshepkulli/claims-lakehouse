DESCRIBE (select * from (
        -- Grain: one row per service month x claim_type x provider specialty (specialty as of the
-- service date). denial_rate = denied claims / claims. denied_billed_amount is what the
-- provider billed on denied claims (paid is always 0 for denied claims).
WITH claims AS (
    SELECT * FROM "claims"."staging"."int_claims_enriched"
)

SELECT
    service_month,
    cast(claim_type AS varchar) AS claim_type,
    cast(provider_specialty AS varchar) AS provider_specialty,
    cast(count(*) AS bigint) AS claim_count,
    cast(count(CASE WHEN is_denied THEN 1 END) AS bigint) AS denied_claim_count,
    cast(
        count(CASE WHEN is_denied THEN 1 END) / nullif(count(*), 0) AS numeric(9, 4)
    ) AS denial_rate,
    cast(sum(billed_amount) AS numeric(18, 2)) AS billed_amount,
    cast(sum(CASE WHEN is_denied THEN billed_amount ELSE 0 END) AS numeric(18, 2))
        AS denied_billed_amount
FROM claims
GROUP BY service_month, claim_type, provider_specialty
    ) as __dbt_sbq
    where false
    limit 0
)
[0m22:29:52.529226 [debug] [Thread-4 (]: On model.claims_lakehouse.mart_member_risk: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "claims_lakehouse", "target_name": "duckdb", "node_id": "model.claims_lakehouse.mart_member_risk"} */
DESCRIBE (select * from (
        -- Grain: one row per member_id (current version), including members with no claims.
-- risk_score is a SYNTHETIC cost-percentile heuristic (0-100, percent_rank of total paid),
-- not an actuarial or clinical risk model. age_years is measured at the last service
-- date in the data, not today.
WITH members AS (
    SELECT
        member_id,
        birth_year,
        sex,
        state_code,
        plan_type,
        enrollment_date
    FROM "claims"."staging"."stg_gold__dim_member"
    WHERE is_current
),

claims AS (
    SELECT * FROM "claims"."staging"."int_claims_enriched"
),

as_of AS (
    SELECT max(service_date) AS as_of_date FROM claims
),

agg AS (
    SELECT
        member_id,
        count(*) AS claim_count,
        count(CASE WHEN is_denied THEN 1 END) AS denied_claim_count,
        count(CASE WHEN claim_type = 'INSTITUTIONAL' AND NOT is_denied THEN 1 END)
            AS institutional_claim_count,
        count(CASE WHEN is_readmission_proxy THEN 1 END) AS readmission_proxy_count,
        count(DISTINCT provider_id) AS distinct_provider_count,
        sum(allowed_amount) AS allowed_amount,
        sum(paid_amount) AS paid_amount,
        max(service_date) AS last_service_date
    FROM claims
    GROUP BY member_id
),

scored AS (
    SELECT
        m.member_id,
        m.birth_year,
        m.sex,
        m.state_code,
        m.plan_type,
        m.enrollment_date,
        a.last_service_date,
        coalesce(a.claim_count, 0) AS claim_count,
        coalesce(a.denied_claim_count, 0) AS denied_claim_count,
        coalesce(a.institutional_claim_count, 0) AS institutional_claim_count,
        coalesce(a.readmission_proxy_count, 0) AS readmission_proxy_count,
        coalesce(a.distinct_provider_count, 0) AS distinct_provider_count,
        coalesce(a.allowed_amount, 0) AS allowed_amount,
        coalesce(a.paid_amount, 0) AS paid_amount,
        year(o.as_of_date) - m.birth_year AS age_years,
        100 * percent_rank() OVER (
            ORDER BY coalesce(a.paid_amount, 0)
        ) AS risk_score
    FROM members AS m
    CROSS JOIN as_of AS o
    LEFT JOIN agg AS a ON m.member_id = a.member_id
)

SELECT
    cast(member_id AS varchar) AS member_id,
    cast(birth_year AS smallint) AS birth_year,
    cast(age_years AS smallint) AS age_years,
    cast(sex AS varchar) AS sex,
    cast(state_code AS varchar) AS state_code,
    cast(plan_type AS varchar) AS plan_type,
    enrollment_date,
    last_service_date,
    cast(claim_count AS bigint) AS claim_count,
    cast(denied_claim_count AS bigint) AS denied_claim_count,
    cast(institutional_claim_count AS bigint) AS institutional_claim_count,
    cast(readmission_proxy_count AS bigint) AS readmission_proxy_count,
    cast(distinct_provider_count AS bigint) AS distinct_provider_count,
    cast(allowed_amount AS numeric(18, 2)) AS allowed_amount,
    cast(paid_amount AS numeric(18, 2)) AS paid_amount,
    cast(risk_score AS numeric(5, 1)) AS risk_score,
    cast(
        CASE
            WHEN risk_score >= 90 THEN 'HIGH'
            WHEN risk_score >= 60 THEN 'MEDIUM'
            ELSE 'LOW'
        END AS varchar
    ) AS risk_tier
FROM scored
    ) as __dbt_sbq
    where false
    limit 0
)
[0m22:29:52.529539 [debug] [Thread-1 (]: On model.claims_lakehouse.mart_provider_performance: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "claims_lakehouse", "target_name": "duckdb", "node_id": "model.claims_lakehouse.mart_provider_performance"} */
DESCRIBE (select * from (
        -- Grain: one row per provider_id per service month. Provider attributes are the CURRENT
-- version (is_current), so a provider appears once per month even if its SCD2 version
-- changed mid-month. specialty_cost_index = provider allowed per claim / specialty
-- allowed per claim for the same month (1.0 = at specialty average).
WITH claims AS (
    SELECT * FROM "claims"."staging"."int_claims_enriched"
),

lines AS (
    SELECT
        c.provider_id,
        c.service_month,
        count(*) AS line_count
    FROM "claims"."staging"."stg_gold__fact_claim_line" AS l
    INNER JOIN claims AS c ON l.claim_id = c.claim_id
    GROUP BY c.provider_id, c.service_month
),

providers AS (
    SELECT
        provider_id,
        specialty,
        state_code,
        network_status,
        cost_tier
    FROM "claims"."staging"."stg_gold__dim_provider"
    WHERE is_current
),

agg AS (
    SELECT
        provider_id,
        service_month,
        count(*) AS claim_count,
        count(CASE WHEN is_denied THEN 1 END) AS denied_claim_count,
        count(DISTINCT member_id) AS unique_members,
        sum(allowed_amount) AS allowed_amount,
        sum(paid_amount) AS paid_amount,
        count(CASE WHEN is_readmission_proxy THEN 1 END) AS readmission_proxy_count
    FROM claims
    GROUP BY provider_id, service_month
),

joined AS (
    SELECT
        a.*,
        p.specialty,
        p.state_code,
        p.network_status,
        p.cost_tier,
        l.line_count,
        sum(a.allowed_amount) OVER (PARTITION BY p.specialty, a.service_month)
        / sum(a.claim_count) OVER (PARTITION BY p.specialty, a.service_month)
            AS specialty_allowed_per_claim
    FROM agg AS a
    INNER JOIN providers AS p ON a.provider_id = p.provider_id
    LEFT JOIN lines AS l ON a.provider_id = l.provider_id AND a.service_month = l.service_month
)

SELECT
    cast(provider_id AS varchar) AS provider_id,
    service_month,
    cast(specialty AS varchar) AS specialty,
    cast(state_code AS varchar) AS state_code,
    cast(network_status AS varchar) AS network_status,
    cast(cost_tier AS varchar) AS cost_tier,
    cast(claim_count AS bigint) AS claim_count,
    cast(denied_claim_count AS bigint) AS denied_claim_count,
    cast(unique_members AS bigint) AS unique_members,
    cast(coalesce(line_count, 0) AS bigint) AS line_count,
    cast(allowed_amount AS numeric(18, 2)) AS allowed_amount,
    cast(paid_amount AS numeric(18, 2)) AS paid_amount,
    cast(readmission_proxy_count AS bigint) AS readmission_proxy_count,
    cast(denied_claim_count / nullif(claim_count, 0) AS numeric(9, 4)) AS denial_rate,
    cast(allowed_amount / nullif(line_count, 0) AS numeric(18, 2)) AS avg_allowed_per_line,
    cast(paid_amount / nullif(claim_count, 0) AS numeric(18, 2)) AS avg_paid_per_claim,
    cast(
        (allowed_amount / nullif(claim_count, 0)) / nullif(specialty_allowed_per_claim, 0)
        AS numeric(9, 4)
    ) AS specialty_cost_index
FROM joined
    ) as __dbt_sbq
    where false
    limit 0
)
[0m22:29:52.529839 [debug] [Thread-3 (]: On model.claims_lakehouse.mart_claims_monthly: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "claims_lakehouse", "target_name": "duckdb", "node_id": "model.claims_lakehouse.mart_claims_monthly"} */
DESCRIBE (select * from (
        -- Grain: one row per service month (all claim types). Additive columns sum across months;
-- member_months is the month's enrolled-member count and must not be summed across
-- breakdowns. PMPM = paid_amount / member_months.
WITH claims AS (
    SELECT * FROM "claims"."staging"."int_claims_enriched"
),

line_counts AS (
    SELECT
        cast(date_trunc('month', service_date) AS date) AS service_month,
        count(*) AS line_count,
        sum(allowed_amount) AS line_allowed_amount
    FROM "claims"."staging"."stg_gold__fact_claim_line"
    GROUP BY service_month
),

monthly AS (
    SELECT
        service_month,
        cast(year(service_month) * 100 + month(service_month) AS integer) AS month_key,
        count(*) AS claim_count,
        count(CASE WHEN is_denied THEN 1 END) AS denied_claim_count,
        count(DISTINCT member_id) AS active_member_count,
        sum(billed_amount) AS billed_amount,
        sum(allowed_amount) AS allowed_amount,
        sum(paid_amount) AS paid_amount,
        sum(CASE WHEN claim_type = 'PROFESSIONAL' THEN paid_amount ELSE 0 END)
            AS professional_paid_amount,
        sum(CASE WHEN claim_type = 'INSTITUTIONAL' THEN paid_amount ELSE 0 END)
            AS institutional_paid_amount,
        sum(CASE WHEN claim_type = 'PHARMACY' THEN paid_amount ELSE 0 END)
            AS pharmacy_paid_amount,
        count(CASE WHEN is_readmission_proxy THEN 1 END) AS readmission_proxy_count
    FROM claims
    GROUP BY service_month, month_key
)

SELECT
    m.month_key,
    m.service_month,
    cast(m.claim_count AS bigint) AS claim_count,
    cast(m.denied_claim_count AS bigint) AS denied_claim_count,
    cast(m.active_member_count AS bigint) AS active_member_count,
    cast(mm.member_months AS bigint) AS member_months,
    cast(l.line_count AS bigint) AS line_count,
    cast(m.billed_amount AS numeric(18, 2)) AS billed_amount,
    cast(m.allowed_amount AS numeric(18, 2)) AS allowed_amount,
    cast(m.paid_amount AS numeric(18, 2)) AS paid_amount,
    cast(m.professional_paid_amount AS numeric(18, 2)) AS professional_paid_amount,
    cast(m.institutional_paid_amount AS numeric(18, 2)) AS institutional_paid_amount,
    cast(m.pharmacy_paid_amount AS numeric(18, 2)) AS pharmacy_paid_amount,
    cast(m.readmission_proxy_count AS bigint) AS readmission_proxy_count,
    cast(m.paid_amount / nullif(mm.member_months, 0) AS numeric(18, 2)) AS pmpm_paid,
    cast(m.denied_claim_count / nullif(m.claim_count, 0) AS numeric(9, 4)) AS denial_rate,
    cast(l.line_allowed_amount / nullif(l.line_count, 0) AS numeric(18, 2)) AS avg_allowed_per_line
FROM monthly AS m
INNER JOIN "claims"."staging"."int_member_months" AS mm ON m.service_month = mm.service_month
LEFT JOIN line_counts AS l ON m.service_month = l.service_month
    ) as __dbt_sbq
    where false
    limit 0
)
