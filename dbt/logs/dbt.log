  create view "claims"."staging"."stg_gold__fact_claim__dbt_tmp" as (
    SELECT
    claim_id,
    member_sk,
    provider_sk,
    primary_diagnosis_sk,
    cast(
        substr(cast(service_date_key as varchar), 1, 4) || '-'
        || substr(cast(service_date_key as varchar), 5, 2) || '-'
        || substr(cast(service_date_key as varchar), 7, 2) as date
    ) AS service_date,
    cast(
        substr(cast(received_date_key as varchar), 1, 4) || '-'
        || substr(cast(received_date_key as varchar), 5, 2) || '-'
        || substr(cast(received_date_key as varchar), 7, 2) as date
    ) AS received_date,
    upper(trim(claim_type)) AS claim_type,
    place_of_service,
    upper(trim(claim_status)) AS claim_status,
    upper(trim(claim_status)) = 'DENIED' AS is_denied,
    line_count,
    cast(total_billed_amount AS numeric(12, 2)) AS billed_amount,
    cast(total_allowed_amount AS numeric(12, 2)) AS allowed_amount,
    cast(total_paid_amount AS numeric(12, 2)) AS paid_amount,
    loaded_at AS _loaded_at
FROM 'data/gold/fact_claim/*.parquet'
  );

