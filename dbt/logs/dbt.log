    create  table
      "claims"."marts"."mart_claims_monthly__dbt_tmp"
  
  (
    month_key integer not null,
    service_month date not null,
    claim_count bigint not null,
    denied_claim_count bigint not null,
    active_member_count bigint not null,
    member_months bigint,
    line_count bigint,
    billed_amount numeric(18,2) not null,
    allowed_amount numeric(18,2) not null,
