[0m22:24:43.444013 [debug] [Thread-1 (]: Using duckdb connection "model.claims_lakehouse.int_member_months"
[0m22:24:43.444190 [debug] [Thread-1 (]: On model.claims_lakehouse.int_member_months: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "claims_lakehouse", "target_name": "duckdb", "node_id": "model.claims_lakehouse.int_member_months"} */

  
  create view "bad"."staging"."int_member_months__dbt_tmp" as (
    -- Grain: one row per calendar month. member_months = members enrolled on or before
-- the last day of the month (current member versions only; enrollment is open-ended
-- in the synthetic data, no disenrollment). Null enrollment_date counts as enrolled.
WITH months AS (
    SELECT DISTINCT cast(date_trunc('month', date_day) AS date) AS service_month
    FROM "bad"."staging"."stg_gold__dim_date"
),

members AS (
    SELECT
        member_id,
        enrollment_date
    FROM "bad"."staging"."stg_gold__dim_member"
    WHERE is_current
)

SELECT
    months.service_month,
    count(members.member_id) AS member_months
FROM months
LEFT JOIN members
    ON members.enrollment_date IS NULL OR members.enrollment_date <= last_day(months.service_month)
GROUP BY months.service_month
  );

