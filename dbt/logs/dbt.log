[0m22:24:24.921349 [debug] [Thread-2 (]: On model.claims_lakehouse.mart_denials: /* {"app": "dbt", "dbt_version": "1.12.6", "profile_name": "claims_lakehouse", "target_name": "duckdb", "node_id": "model.claims_lakehouse.mart_denials"} */
DESCRIBE (select * from (
        -- Grain: one row per service month x claim_type x provider specialty (specialty as of the
-- service date). denial_rate = denied claims / claims. denied_billed_amount is what the
