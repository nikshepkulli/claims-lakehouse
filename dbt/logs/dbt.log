    UNION ALL
    SELECT
        'mart_denials.claims' AS metric,
        (SELECT sum(claim_count) FROM "claims"."marts"."mart_denials") AS mart_value,
        (SELECT claims FROM stg) AS stg_value
)

SELECT *
FROM checks
WHERE mart_value != stg_value
  
  
      
