  -- Totals in the marts equal totals in staging (no claim lost or double counted in joins).
-- Returns a row per metric that does not match.
WITH stg AS (
    SELECT
        count(*) AS claims,
        sum(paid_amount) AS paid
    FROM "claims"."staging"."stg_gold__fact_claim"
),

checks AS (
    SELECT
        'mart_claims_monthly.paid' AS metric,
        (SELECT sum(paid_amount) FROM "claims"."marts"."mart_claims_monthly") AS mart_value,
        (SELECT paid FROM stg) AS stg_value
    UNION ALL
    SELECT
        'mart_claims_monthly.claims' AS metric,
        (SELECT sum(claim_count) FROM "claims"."marts"."mart_claims_monthly") AS mart_value,
        (SELECT claims FROM stg) AS stg_value
    UNION ALL
    SELECT
        'mart_provider_performance.paid' AS metric,
        (SELECT sum(paid_amount) FROM "claims"."marts"."mart_provider_performance") AS mart_value,
        (SELECT paid FROM stg) AS stg_value
    UNION ALL
    SELECT
