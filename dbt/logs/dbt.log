        count(*) AS claims,
        sum(paid_amount) AS paid
    FROM "claims"."staging"."stg_gold__fact_claim"
),

checks AS (
    SELECT
        'mart_claims_monthly.paid' AS metric,
        (SELECT sum(paid_amount) FROM "claims"."marts"."mart_claims_monthly") AS mart_value,
        (SELECT paid FROM stg) AS stg_value
    UNION ALL
    SELECT
        'mart_claims_monthly.claims',
        (SELECT sum(claim_count) FROM "claims"."marts"."mart_claims_monthly"),
        (SELECT claims FROM stg)
    UNION ALL
    SELECT
        'mart_provider_performance.paid',
        (SELECT sum(paid_amount) FROM "claims"."marts"."mart_provider_performance"),
        (SELECT paid FROM stg)
    UNION ALL
    SELECT
        'mart_member_risk.paid',
        (SELECT sum(paid_amount) FROM "claims"."marts"."mart_member_risk"),
        (SELECT paid FROM stg)
    UNION ALL
    SELECT
        'mart_denials.claims',
        (SELECT sum(claim_count) FROM "claims"."marts"."mart_denials"),
        (SELECT claims FROM stg)
)

SELECT *
FROM checks
WHERE mart_value != stg_value
  
  
      
    ) dbt_internal_test
