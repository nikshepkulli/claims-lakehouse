    )
 ;
    
    
    insert into "claims"."marts"."mart_claims_monthly__dbt_tmp" 
  (
    
      
      
      month_key ,
    
      
      
      service_month ,
    
      
      
      claim_count ,
    
      
      
      denied_claim_count ,
    
      
      
      active_member_count ,
    
      
      
