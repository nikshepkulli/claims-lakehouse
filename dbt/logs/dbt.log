    create  table
      "claims"."marts"."mart_provider_performance__dbt_tmp"
  
  (
    provider_id varchar not null,
    service_month date not null,
    specialty varchar,
    state_code varchar,
    network_status varchar,
    cost_tier varchar,
    claim_count bigint not null,
    denied_claim_count bigint not null,
